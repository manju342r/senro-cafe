# --- CaféOS: client keys (safe for browser) ---
# Supabase Configuration (Frontend & Backend Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- CaféOS: server keys (NEVER prefix with VITE_ / NEVER expose to browser) ---
# Use these in api/* serverless functions and Supabase dashboard only.
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-for-server-side-admin-ops
# GROQ_API_KEY=groq-key-for-ai-analysis-endpoint
# LLM_API_KEY=fallback-llm-key
# HINDSIGHT_API_KEY=vectorize-hindsight-key
# RESEND_API_KEY=resend-key-for-staff-alerts

# --- Legacy Senro.AI keys (competitor tracking; not used by CaféOS) ---
# The following keys are managed per-user via the /dashboard/settings UI
# and stored securely in the Supabase `user_settings` table.
# However, if you are testing locally without the database, you can use these:
VITE_BRIGHT_DATA_KEY=your_bright_data_web_unlocker_token
VITE_HINDSIGHT_API_KEY=your_vectorize_hindsight_api_key
VITE_RESEND_API_KEY=your_resend_api_key
VITE_LLM_API_KEY=your_featherless_or_openai_api_key
