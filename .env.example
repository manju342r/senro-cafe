# Supabase (live menu, orders, customers)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional server key (Project Settings → API → service_role) — never expose as VITE_
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Super admin — Gmail / Google login
# ---------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_ADMIN_EMAILS=you@gmail.com
ADMIN_EMAILS=you@gmail.com

# ---------------------------------------------------------------------------
# Café chatbot — FREE Gemini (server only; NEVER use VITE_ prefix)
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
RAG_CHAT_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Order confirmation SMS (server only) — pick ONE provider
# Fast2SMS (India): https://www.fast2sms.com → Dev API
# ---------------------------------------------------------------------------
FAST2SMS_API_KEY=
# Or Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
